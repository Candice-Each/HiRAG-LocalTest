  <data key="d2">chunk-03b36ba11357053a39ca2249116c43d5</data>
</node>
<node id="&quot;EXPLOSION OF A RECEIVER OR CONTAINER STORING GASES UNDER PRESSURE AT ATMOSPHERIC PRESSURES, INCLUDING AIR AND COMPRESSED GASES AS LIQUIDS OR SOLIDS.&quot;">
