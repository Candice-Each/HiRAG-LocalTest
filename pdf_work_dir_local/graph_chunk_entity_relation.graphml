  <data key="d2">chunk-0c2575de447c966aae5e5a22feec1323</data>
  <data key="d3">[{"level": 0, "cluster": 1}]</data>
</node>
<node id="&quot;ACCIDENT OR INJURY TO WORKMEN&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Accident or injury to workmen refers to incidents that may occur during the course of employment, requiring notice from contractors."&lt;SEP&gt;"Incidents involving harm to workers during construction activities, addressed under Clause 28 of the document."</data>
  <data key="d2">chunk-0c2575de447c966aae5e5a22feec1323&lt;SEP&gt;chunk-9df361e92365fbde2d17501741344b9a</data>
