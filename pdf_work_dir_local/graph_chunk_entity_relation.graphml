  <data key="d6">chunk-adab7939e3cd66e530eb16d94f47de64</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;合计金额上限&quot;" target="&quot;根据第6(1)条须付的补偿总额经扣除任何已支付补偿后的45% &quot;">
  <data key="d4">9.0</data>
