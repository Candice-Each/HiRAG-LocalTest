  <data key="d0">"MATHEMATICS"</data>
  <data key="d1">"These periods are specified durations within which certain actions, such as issuing certificates, must be completed after the occurrence of a fatal event. The exact dates depend on whether it is based on the date of death or the incident."</data>
  <data key="d2">chunk-def49c83275f7a43c7888fbfe05b6999</data>
</node>
