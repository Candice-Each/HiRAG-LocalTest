  <data key="d6">chunk-0f54e9b22c9d8618d9622420065b132a</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;合資格項目&quot;" target="&quot;每一項第(1)(A)(II)款提述的僱主供款職業退休計劃利益(屬僱主供款(基本部分)豁免職業退休計劃利益者)&quot;">
  <data key="d4">8.0</data>
