</node>
<node id="&quot;MACAO AWARDS&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"Macao awards are legal documents subject to specific conditions of enforcement as outlined in the text."&lt;SEP&gt;"Macao awards are legal documents that may be enforced, requiring specific evidence and conditions to be met."</data>
  <data key="d2">chunk-feb384a29e745420d0a68b05f9a55801&lt;SEP&gt;chunk-74a8e51496cea628136989290d2eaf6c</data>
