  <data key="d6">chunk-11e05d44f5461a2b7dca424d8058b93d</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;SECTION 6(1)(C)&quot;" target="&quot;66 OF 1993 S. 2&quot;">
  <data key="d4">5.0</data>
  <data key="d5">"66 OF 1993 S. 2 amended the calculation method for compensation in fatal cases as referenced by SECTION 6(1)(C). "</data>
  <data key="d6">chunk-11e05d44f5461a2b7dca424d8058b93d</data>
  <data key="d7">1</data>
</edge>
