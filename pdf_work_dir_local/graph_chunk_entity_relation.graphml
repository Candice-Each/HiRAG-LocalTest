</node>
<node id="&quot;NEW EMPLOYMENT CONTRACT&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"A new employment contract may replace or renew an existing one under certain conditions as described in the text without resulting in severance pay for unreasonable rejection."</data>
  <data key="d2">chunk-18f452820ec690c39e359260ee75e592</data>
  <data key="d3">[{"level": 0, "cluster": 9}, {"level": 1, "cluster": 171}, {"level": 2, "cluster": 706}]</data>
