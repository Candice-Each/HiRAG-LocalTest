  <data key="d0">"PRODUCT,TECHNOLOGY"</data>
  <data key="d1">"An appropriate medical certificate is a document issued by registered healthcare professionals to validate an employee's need for sick leave or other health-related benefits as per the regulations outlined in this section."</data>
