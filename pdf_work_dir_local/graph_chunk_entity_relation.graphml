  <data key="d3">[{"level": 0, "cluster": 48}, {"level": 1, "cluster": 404}, {"level": 2, "cluster": 1099}]</data>
</node>
<node id="&quot;SAME TRADE OR OCCUPATION AND AT THE SAME WORK IN THE SAME DISTRICT&quot;">
  <data key="d0">"LOCATION"</data>
  <data key="d1">"This phrase refers to another employee who works in the same industry and performs similar tasks within the same geographical area as a reference point for calculating wages when direct comparison is impractical."</data>
