  <data key="d4">7.0</data>
  <data key="d5">"Annual leave is granted in addition to rest days, holidays, maternity leave and paternity leave as per the ordinance."</data>
  <data key="d6">chunk-13c30dec17d1cd754d99b0830f49589c</data>
  <data key="d7">1</data>
</edge>
