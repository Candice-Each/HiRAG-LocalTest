</node>
<node id="&quot;CIVIL ACTIONS&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Civil Actions refer to legal proceedings brought before a court involving disputes between individuals or organizations over private rights and obligations."</data>
  <data key="d2">chunk-47d0715aec1431ae85a3a9f75d33c852</data>
  <data key="d3">[{"level": 0, "cluster": 5}, {"level": 1, "cluster": 142}, {"level": 2, "cluster": 626}]</data>
