  <data key="d2">chunk-79816614535478a4c5093238ccf5e99a</data>
  <data key="d3">[{"level": 0, "cluster": 31}, {"level": 1, "cluster": 344}, {"level": 2, "cluster": 1032}]</data>
</node>
<node id="&quot;CONSTRUCTION SITE INSPECTION&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"A Construction Site Inspection is an activity carried out under section 35(1) where independent experts are appointed to inspect a site, work, or any other thing."</data>
  <data key="d2">chunk-705ea4a40e2dfeb073559acd2aab072a</data>
