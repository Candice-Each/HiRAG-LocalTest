  <data key="d0">"EVENT"</data>
  <data key="d1">"The death of an employee with at least 5 continuous employment years entitles their estate or dependents to a long service payment according to specific legal provisions."</data>
  <data key="d2">chunk-bc7d719876b6f50011d4a77def5a2428</data>
</node>
