  <data key="d2">chunk-e1ba134cba7bc0ad2b2ef34e757e78d3</data>
</node>
<node id="&quot;SECTION 63(4)(E)&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Section 63(4)(e) is a legal provision that may be relevant in cases of employee misconduct or non-compliance with company policies affecting annual leave entitlements."</data>
  <data key="d2">chunk-b63d3371d1b762c2013adc08da9c549f</data>
