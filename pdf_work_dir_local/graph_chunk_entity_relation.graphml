<node id="&quot;LANDS AND WORKS MODEL ARBITRATION RULES&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"The Lands and Works Model Arbitration Rules are the rules that apply to any arbitration instituted according to this clause unless parties agree otherwise."</data>
