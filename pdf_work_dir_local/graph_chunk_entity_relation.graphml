<node id="&quot;24 MONTHS OF PERIODICAL PAYMENTS&quot;">
  <data key="d0">"MATHEMATICS"</data>
  <data key="d1">"Periodical payments cease after a maximum of 24 months from the start of temporary incapacity unless extended by court order, indicating a time limit on benefits based on incapacity duration."</data>
  <data key="d2">chunk-bad177b227e380cc066abb25e6c2cf7d</data>
