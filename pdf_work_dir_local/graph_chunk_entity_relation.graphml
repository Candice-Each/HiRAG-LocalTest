  <data key="d4">7.0</data>
  <data key="d5">"This amendment is part of the broader context of ordinance amendments affecting medical plans and treatment."</data>
  <data key="d6">chunk-73492d2774f700c9b55459d33fea445f</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;24号法律公告第91条 (ANNEXURE 24 SECTION 91)&quot;" target="&quot;ORDINANCE AMENDMENT&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"Annexure references are mentioned in relation to ordinance amendments, indicating their relevance."</data>
  <data key="d6">chunk-73492d2774f700c9b55459d33fea445f</data>
  <data key="d7">1</data>
</edge>
