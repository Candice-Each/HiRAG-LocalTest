  <data key="d2">&lt;SEP&gt;chunk-1e28ad3fe56bbc0f196e83b01855316a</data>
  <data key="d3">[{"level": 0, "cluster": 35}, {"level": 1, "cluster": 354}, {"level": 2, "cluster": 1053}]</data>
</node>
<node id="&quot;OPENING TENDERS&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"The event of opening tenders involves the actions taken by the Tender Opening Team on a specific date and time as per the procedures outlined in NTT A2 Procedures."</data>
  <data key="d2">chunk-1e28ad3fe56bbc0f196e83b01855316a</data>
  <data key="d3">[{"level": 0, "cluster": 35}, {"level": 1, "cluster": 354}, {"level": 2, "cluster": 1053}]</data>
</node>
<node id="&quot;NTT A3 PRE-TENDER MEETING&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"The NTT A3 Pre-tender Meeting is a scheduled event for tenderers to attend and receive important information before the official tender process."</data>
  <data key="d2">chunk-cd345cf9a46f3f5c66ee8c178fe17aed</data>
