  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"Ensuring that the workplace is safe and without risks to health, including premises, access routes, plant, and substances kept on-site."</data>
  <data key="d2">chunk-0812f6740fa10908c6c96dfb7b577a49</data>
</node>
<node id="&quot;EMPLOYER-EMPLOYEE COOPERATION&quot;">
