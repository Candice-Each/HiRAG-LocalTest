  <data key="d3">[{"level": 0, "cluster": 9}, {"level": 1, "cluster": 169}, {"level": 2, "cluster": 700}]</data>
</node>
<node id="&quot;30 NORMAL WORKING DAYS&quot;">
  <data key="d0">"MATHEMATICS"</data>
  <data key="d1">"Thirty normal working days is used as a reference period for calculating certain components of long service payment, particularly when an employee's pre-transition or post-transition employment does not cover at least one month."</data>
  <data key="d2">chunk-8c7aef455ebf5c49827835bcb4e365e9</data>
  <data key="d3">[{"level": 0, "cluster": 9}, {"level": 1, "cluster": 163}, {"level": 2, "cluster": 675}]</data>
</node>
