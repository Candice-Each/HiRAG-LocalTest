  <data key="d0">"PRODUCT/TECHNOLOGY"</data>
  <data key="d1">"The Reply Slip is a document that tenderers must complete and submit, containing information about their attendance and representatives for the pre-tender meeting."</data>
  <data key="d2">chunk-cd345cf9a46f3f5c66ee8c178fe17aed</data>
  <data key="d3">[{"level": 0, "cluster": 7}, {"level": 1, "cluster": 49}, {"level": 2, "cluster": 77}]</data>
</node>
