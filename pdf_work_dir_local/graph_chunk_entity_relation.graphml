  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"Written instructions issued by the Authority, which can be given to individuals using or promoting the use of specified products."</data>
  <data key="d2">chunk-5997efc3513d7a18a8e6ffade96f199b</data>
</node>
<node id="&quot;EXCESSIVE NOISE EMISSION DURING USAGE&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Excessive noise emitted when a product is used improperly, triggering regulatory actions and directions from the authority."</data>
  <data key="d2">chunk-5997efc3513d7a18a8e6ffade96f199b</data>
</node>
<node id="&quot;PRESCRIBED PRODUCT&quot;">
