  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"These are specific sections in an ordinance or law that have been modified to change how certain calculations are performed regarding employee wages and benefits."</data>
  <data key="d2">chunk-4c5336f48f2648be18accb456b032c71</data>
  <data key="d3">[{"level": 0, "cluster": 9}, {"level": 1, "cluster": 169}, {"level": 2, "cluster": 698}]</data>
