  <data key="d3">[{"level": 0, "cluster": 2}, {"level": 1, "cluster": 107}, {"level": 2, "cluster": 548}]</data>
</node>
<node id="&quot;PART IIA&quot;">
  <data key="d0">"INDUSTRY"</data>
  <data key="d1">"Part IIA is an industry-specific regulation that applies additional conditions or rules for certain types of employment contracts, particularly those involving end-of-year payments."&lt;SEP&gt;"Part refers to sections within a legal document and does not represent an independent entity here."</data>
  <data key="d2">chunk-f1c30b39b26dc22df210f2ea63b93552&lt;SEP&gt;chunk-6cdefd54629d3267d124166ba92131ae</data>
