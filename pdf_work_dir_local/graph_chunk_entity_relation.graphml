<node id="&quot;CONTINUOUS EMPLOYMENT&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Continuous Employment refers to the condition of an employee being continuously employed for a period of four weeks or more according to specific criteria outlined in the ordinance."</data>
  <data key="d2">chunk-3639cabcc91a09d2612cb06c302addd4</data>
  <data key="d3">[{"level": 0, "cluster": 11}, {"level": 1, "cluster": 187}]</data>
</node>
