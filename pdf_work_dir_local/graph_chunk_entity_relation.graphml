<node id="&quot;SURGICAL FEES AND THERAPY FEES&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"Surgical procedures and therapies provided by healthcare professionals have associated costs that may be covered under medical expenses."</data>
  <data key="d2">chunk-d88128975194421da26a5cd7caa858a0</data>
