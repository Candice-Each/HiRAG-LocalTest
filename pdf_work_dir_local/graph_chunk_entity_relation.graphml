  <data key="d2">chunk-7f9b169ef4b1de04369879d234076f1c</data>
</node>
<node id="&quot;施行本部而发出的保险单&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"Insurance single issued for implementing this part refers to policies specifically created or updated according to regulations related to employment and insurance coverage as outlined in certain sections of the law."</data>
  <data key="d2">chunk-7f9b169ef4b1de04369879d234076f1c</data>
</node>
<node id="&quot;可得的保险单承保款额&quot;">
  <data key="d0">"MATHEMATICS"</data>
