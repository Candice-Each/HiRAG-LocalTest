  <data key="d7">1</data>
</edge>
<edge source="&quot;THIS ORDINANCE&quot;" target="&quot;IMPRISONMENT FOR A TERM OF 3 MONTHS&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Imprisonment for three months can be imposed as a penalty for offences under this Ordinance and its regulations."</data>
  <data key="d6">chunk-01f73d3a0eb5a63d428e456a11dad9c0</data>
  <data key="d7">1</data>
</edge>
