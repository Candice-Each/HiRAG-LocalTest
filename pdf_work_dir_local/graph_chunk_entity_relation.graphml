  <data key="d6">chunk-4f5c32e3a6975f5012a9f880a409dd60</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;ORDINANCE&quot;" target="&quot;COMPENSATION&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The Ordinance outlines rules for compensation claimed in respect of injuries to employees, including disallowance criteria and exceptions."</data>
