<node id="&quot;MANDATORY PROVIDENT FUND CONTRIBUTION&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"Mandatory provident fund contribution refers to funds that employers are required to contribute on behalf of their employees into a public pension or savings plan as per regulations."</data>
