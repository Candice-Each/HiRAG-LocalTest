  <data key="d4">9.0</data>
  <data key="d5">"The employment relationship ends with EMPLOYMENT CESSER, affecting entitlements like ANNUAL LEAVE PAY and ANNUAL LEAVE."</data>
  <data key="d6">chunk-4b74bf264f43f2a8be1c1c6d9a90273b</data>
