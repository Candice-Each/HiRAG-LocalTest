<node id="&quot;STONE QUARRY&quot;">
  <data key="d0">"LOCATION"</data>
  <data key="d1">"A Stone Quarry is an industrial location where stone mining operations take place and can experience collapses of overburden, faces, tips, or embankments."</data>
