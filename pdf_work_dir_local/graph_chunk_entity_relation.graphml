  <data key="d4">8.0</data>
  <data key="d5">"根據第(3)款規定，在同一宗意外中，若已根據第7或9條支付補償，則需扣除這些費用。"</data>
  <data key="d6">chunk-8d6f58db2bf906e62e1287ce399d4434</data>
  <data key="d7">1</data>
</edge>
