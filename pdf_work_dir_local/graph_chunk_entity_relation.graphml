  <data key="d7">1</data>
</edge>
<edge source="&quot;MATERNITY LEAVE PAY (產假薪酬)&quot;" target="&quot;485&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Maternity leave pay is payable under section 14, which can be found in Cap. 485."</data>
  <data key="d6">chunk-765d51e319fa417bcf02401654532054</data>
  <data key="d7">1</data>
</edge>
