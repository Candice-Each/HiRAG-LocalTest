  <data key="d2">chunk-589a96d26470d384098a64e36e5d4b0a</data>
</node>
<node id="&quot;SECTION 72 OTHER THAN SUBSECTION (1)(A), (B) AND (C)&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Section 72 refers to a broader set of provisions that may be applicable except for specific clauses mentioned."</data>
