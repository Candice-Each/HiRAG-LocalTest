</node>
<node id="&quot;FOSSILS&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"Fossils refer to geological or archaeological findings that may be encountered during the course of work and require special handling or documentation."&lt;SEP&gt;"The presence or discovery of fossils during construction work as per Clause 35."</data>
  <data key="d2">chunk-0c2575de447c966aae5e5a22feec1323&lt;SEP&gt;chunk-9df361e92365fbde2d17501741344b9a</data>
  <data key="d3">[{"level": 0, "cluster": 11}]</data>
</node>
<node id="&quot;FACILITIES FOR OTHER CONTRACTORS&quot;">
  <data key="d0">"PRODUCT"</data>
