<node id="&quot;FIRST INTERIM ACCOUNT&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"The First Interim Account is a financial document submitted by the Contractor to provide details of the sum claimed so far and grounds thereof, sent within a reasonable time after giving notice to the Maintenance Surveyor."</data>
  <data key="d2">chunk-06b2afedf5ae2df469662b1c2af2820d</data>
