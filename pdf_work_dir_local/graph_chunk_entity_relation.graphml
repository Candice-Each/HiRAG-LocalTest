<node id="&quot;AVAILABLE AMOUNT COVERED BY THE POLICY OF INSURANCE&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"The available amount covered by the policy of insurance is defined in this context and refers to the total sum insured for legal liabilities, including accidents related to occupational diseases."&lt;SEP&gt;"The available amount is a concept defined as the amount covered by an insurance policy after deducting any paid or due amounts under the same event, as per section 3 of the Insurance Ordinance (Cap. 41)."</data>
  <data key="d2">chunk-fdcb847cbe822aecbab442ce9430887f&lt;SEP&gt;chunk-2b577aefb31326e0dd35b3e4acfd2057</data>
</node>
