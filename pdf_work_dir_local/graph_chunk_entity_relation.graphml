  <data key="d7">1</data>
</edge>
<edge source="&quot;硝基、氨基或氯基衍生物中毒,或硝基氯苯中毒&quot;" target="&quot;煙霧、塵埃或蒸氣中的職業暴露&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"涉及使用或处理含硝基、氨基或氯基衍生物的物质的职业暴露可能导致此类中毒。"</data>
  <data key="d6">chunk-f0ecd9f44b5bcdd46ef57df26ba77a9f</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;C8苯或苯同系物的硝基、氨基或氯基衍生物中毒事件,或硝基氯苯中毒事件&quot;" target="&quot;苯或苯同系物的硝基、氨基或氯基衍生物中毒,或硝基氯苯中毒&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"C8具体描述了与苯或苯同系物的硝基、氨基或氯基衍生物中毒及硝基氯苯中毒相关的职业暴露情况。"</data>
  <data key="d6">chunk-f0ecd9f44b5bcdd46ef57df26ba77a9f</data>
