  <data key="d0">"LEGAL DOCUMENT"</data>
  <data key="d1">"The Old Ordinance IV Part refers to an outdated legal framework or regulation that was in effect before 1997-07-01."</data>
  <data key="d2">chunk-47762eabb07bb9265d79611ab6fc55f6</data>
</node>
