  <data key="d2">chunk-1d00e5d24fe5e70cf9bff7cadb2617bf</data>
</node>
<node id="&quot;MEDICAL REGISTRATION ORDINANCE (CAP. 161)&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"The Medical Registration Ordinance is a legal framework for registering medical practitioners."</data>
  <data key="d2">chunk-87c13a5036ab1fa84c38d60a51990cd9</data>
</node>
<node id="&quot;ALLIED HEALTH PROFESSIONS ORDINANCE (CAP. 359)&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"The Allied Health Professions Ordinance is a legal framework for the registration of allied health professionals such as occupational therapists and physiotherapists."</data>
  <data key="d2">chunk-87c13a5036ab1fa84c38d60a51990cd9</data>
</node>
<node id="&quot;CHINESE PEOPLE'S LIBERATION ARMY&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Members of the Chinese People's Liberation Army are excluded from certain applications under this Ordinance."&lt;SEP&gt;"The Chinese People's Liberation Army refers to a military organization that is excluded from certain provisions under this Ordinance."</data>
  <data key="d2">chunk-f01a3b960a2dbd284b449cf8b37e63c2&lt;SEP&gt;chunk-ae17a545bdd85603b1810f4143f67b98</data>
