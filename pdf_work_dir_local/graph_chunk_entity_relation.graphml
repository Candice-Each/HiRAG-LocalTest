  <data key="d0">"PRODUCT"</data>
  <data key="d1">"Prostheses and Surgical Appliances are medical devices provided under this Part, which can lead to disputes regarding payment or necessity."&lt;SEP&gt;"Prostheses or surgical appliances are medical devices that may be required as a result of an accident, covered by general revenue under certain conditions."</data>
  <data key="d2">chunk-33fb429edfbad9e4130f4746d5db62bd&lt;SEP&gt;chunk-e69f47e10b2e6f7fc8c8517ea228736e</data>
