<node id="&quot;PRE-AMENDMENT WEEK&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Pre-Amendment Week is defined as any week beginning before the date on which the Employment (Amendment) Ordinance 2025 comes into operation, where a higher threshold of work hours must be met to count towards continuous employment."</data>
  <data key="d2">chunk-7d9929bbede2eb72d013426b56ad4e6c</data>
