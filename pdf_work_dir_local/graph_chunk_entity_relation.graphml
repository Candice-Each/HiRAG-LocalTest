  <data key="d0">"PRODUCT"</data>
  <data key="d1">"This describes the manufacturing or supply of products that do not meet noise standards during their warranty period."</data>
  <data key="d2">chunk-ed8223cf90d5d4646feb10ec51169ca9</data>
