  <data key="d4">6.0</data>
  <data key="d5">"The Employees' Compensation Ordinance affects how wages are calculated, including those for annual leave and other types of absences."</data>
  <data key="d6">chunk-5cf406b3b427b0e2efe01c3ec1bb9db4</data>
  <data key="d7">1</data>
</edge>
