<node id="&quot;PERMANENT TOTAL INCAPACITY&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Permanent Total Incapacity is defined as the result of an injury leading to 100% loss of earning capacity according to specified schedules or assessments."&lt;SEP&gt;"Permanent Total Incapacity refers to a state where an employee is unable to work permanently due to injuries."&lt;SEP&gt;"Permanent Total Incapacity refers to the maximum level of incapacity, used as a reference point in calculating compensation percentages."</data>
  <data key="d2">chunk-779a6ebdcf1cc3fbd67a4dc22862c59e&lt;SEP&gt;chunk-430e5976cb2d37cf2cc19b50c8f851c3&lt;SEP&gt;chunk-2d80227f925bf1b081dc41765e6e6934</data>
