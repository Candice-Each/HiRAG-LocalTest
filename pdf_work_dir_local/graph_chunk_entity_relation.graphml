</node>
<node id="&quot;USUAL ADDRESS&quot;">
  <data key="d0">"LOCATION"</data>
  <data key="d1">"Refers to the usual residential or business address where notices can be left according to subsection (1)(b)."</data>
  <data key="d2">chunk-93a1fe97f228ec755ced3c31d6506c86</data>
</node>
<node id="&quot;2010年第9號第4條&quot;">
  <data key="d0">"EVENT/LEGISLATION"</data>
