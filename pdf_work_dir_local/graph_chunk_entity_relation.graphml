<node id="&quot;BANKRUPTCY ORDINANCE (CAP. 6)&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"The Bankruptcy Ordinance (Cap. 6) is a legal document that outlines provisions related to bankruptcy, including the payment of certain types of wages during such situations."</data>
  <data key="d2">chunk-1e3b8e5ac9feac4c8c89dafe20af1c65</data>
  <data key="d3">[{"level": 0, "cluster": 28}, {"level": 1, "cluster": 341}]</data>
