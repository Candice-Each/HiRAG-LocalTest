  <data key="d4">7.0</data>
  <data key="d5">"Authorised institutions are responsible for consulting publicly before issuing practical guidelines and can seek advice from knowledgeable or experienced individuals during this process."</data>
  <data key="d6">chunk-24bcba17e89155ad11eeca80dd981ea9</data>
  <data key="d7">1</data>
</edge>
