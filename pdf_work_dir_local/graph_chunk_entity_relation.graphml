<node id="&quot;INTERIM PAYMENTS&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Interim payments are made during the progress of work under certain conditions, typically not exceeding 80% of the estimated value of completed permanent works."&lt;SEP&gt;"Interim payments refer to partial payments made during the execution of works orders, subject to certain conditions and schedules."</data>
  <data key="d2">chunk-8130c8086938f6df2d05cdf9fb7e405c&lt;SEP&gt;chunk-f144b21e5d9d4c86fe6de033c3b52697</data>
