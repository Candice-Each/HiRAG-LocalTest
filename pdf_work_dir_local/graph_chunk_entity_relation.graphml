<node id="&quot;L.N. 79 OF 1983; L.N. 321 OF 1985; L.N. 390 OF 1987; L.N. 386 OF 1989; L.N. 435 OF 1991; L.N. 463 OF 1993; L.N. 566 OF 1995; 36 OF 1996 S. 4&quot;">
  <data key="d0">"LEGAL DOCUMENT"</data>
