  <data key="d4">6.0</data>
  <data key="d5">"The SUBCONTRACTOR's location outside Hong Kong affects the applicability of arbitration agreements under certain conditions."</data>
  <data key="d6">chunk-ca57b579105e713a9a47fbe85dd981f6</data>
  <data key="d7">1</data>
</edge>
