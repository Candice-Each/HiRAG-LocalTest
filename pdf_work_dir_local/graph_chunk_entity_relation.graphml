</node>
<node id="&quot;UNTIL THE CONTRARY IS PROVED&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"This phrase indicates that a presumption holds until proven otherwise, often used in legal contexts."</data>
  <data key="d2">chunk-ffd0ab37b084efd20396f2b25c97ab3f</data>
</node>
<node id="&quot;THE DOCUMENT IS SUCH LICENCE OR NOTICE&quot;">
