  <data key="d2">chunk-f16e9e25a3dbce715e72ac73a5f618f3&lt;SEP&gt;chunk-1afc47af5e3a98c6449c05cd6d36ada3</data>
</node>
<node id="&quot;TOTAL PARALYSIS&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Total paralysis is defined as 100% loss of earning capacity, indicating the most severe case."&lt;SEP&gt;"Total paralysis signifies the complete loss of muscle function and movement throughout the body."</data>
  <data key="d2">chunk-f16e9e25a3dbce715e72ac73a5f618f3&lt;SEP&gt;chunk-1afc47af5e3a98c6449c05cd6d36ada3</data>
