  <data key="d0">"EVENT"</data>
  <data key="d1">"Event includes the payment of medical expenses for treating injuries in Hong Kong due to incidents occurring outside Hong Kong."</data>
  <data key="d2">chunk-6b09cd3013853d4b808aa668049f33e0</data>
</node>
<node id="&quot;COMPENSATION OTHER THAN MEDICAL EXPENSES&quot;">
  <data key="d0">"PRODUCT"</data>
