</node>
<node id="&quot;TENDER BOARD&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"The Tender Board is an organization that oversees tender processes, including setting close dates and forming the Tender Opening Team."</data>
  <data key="d2">chunk-1e28ad3fe56bbc0f196e83b01855316a</data>
  <data key="d3">[{"level": 0, "cluster": 35}, {"level": 1, "cluster": 354}, {"level": 2, "cluster": 1053}]</data>
