  <data key="d4">7.0</data>
  <data key="d5">"僱員工作於香港的船舶上。"</data>
  <data key="d6">chunk-19284fbf4d548ad004ef52e2b76eaa7d</data>
  <data key="d7">1</data>
</edge>
