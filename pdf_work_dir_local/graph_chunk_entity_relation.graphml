</node>
<node id="&quot;任何職業&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Any occupation involving severe or long-term external friction or pressure on the elbow area."</data>
  <data key="d2">chunk-f469a8579bea72a36a2413fd894d87a8</data>
</node>
<node id="&quot;手或前臂(包括手肘)的腱或相關腱鞘的外傷性炎症&quot;">
  <data key="d0">"DISEASE"</data>
  <data key="d1">"This condition involves traumatic inflammation of tendons or related tendon sheaths in the hand, forearm (including elbow), often associated with physically demanding work and frequent hand or wrist movements."&lt;SEP&gt;"Work-related tenosynovitis of the hand or forearm, including the elbow due to physical labor involving frequent activity or repetitive movements."</data>
  <data key="d2">chunk-50b429f7441b76e64978fbbde04359c3&lt;SEP&gt;chunk-f469a8579bea72a36a2413fd894d87a8</data>
</node>
<node id="&quot;腕管綜合症&quot;">
  <data key="d0">"DISEASE"</data>
  <data key="d1">"Carpal tunnel syndrome caused by repeatedly using handheld power-supplied tools that vibrate and transmit vibrations to the hands, excluding purely manual tool use."</data>
  <data key="d2">chunk-f469a8579bea72a36a2413fd894d87a8</data>
</node>
<node id="&quot;任何涉及接觸患炭疽的動物或處理(包括起卸或運送)動物產品或殘留物的職業&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Any occupation involving contact with animals infected with anthrax or handling (including loading and unloading, transporting) animal products or residues."</data>
  <data key="d2">chunk-f469a8579bea72a36a2413fd894d87a8</data>
</node>
<node id="&quot;任何涉及接觸馬科動物或其屍體的職業&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Any occupation involving contact with equine animals or their carcasses."</data>
  <data key="d2">chunk-f469a8579bea72a36a2413fd894d87a8</data>
</node>
<node id="&quot;任何涉及下列情況的職業——(A) 在受到或可能受到老鼠、田鼠或野鼠,或其他哺乳類小動物侵擾的地方工作;(B) 在狗房工作,或照料或處理狗隻&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Any occupation involving the following situations: (a) working in areas infested by rats, field mice or wild rodents, or other small mammals; (b) working in dog houses, caring for or handling dogs."</data>
  <data key="d2">chunk-f469a8579bea72a36a2413fd894d87a8</data>
</node>
<node id="&quot;任何涉及接觸牛科動物或牛肉產品,或豬隻或豬肉產品&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Any occupation involving contact with cattle or beef products, pigs or pork products."</data>
  <data key="d2">chunk-f469a8579bea72a36a2413fd894d87a8</data>
</node>
<node id="&quot;老鼠、田鼠或野鼠,或其他哺乳類小動物&quot;">
  <data key="d0">"LOCATION"</data>
