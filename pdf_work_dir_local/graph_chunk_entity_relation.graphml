  <data key="d0">"EVENT"</data>
  <data key="d1">"Another amendment from 1992, further modifying certain sections of the ordinance regarding employment agencies."</data>
  <data key="d2">chunk-d8d055b17ca5d7c4bc065dbbfefc9360</data>
