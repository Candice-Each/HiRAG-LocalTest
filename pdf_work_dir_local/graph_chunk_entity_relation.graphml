  <data key="d2">chunk-d8d055b17ca5d7c4bc065dbbfefc9360</data>
</node>
<node id="&quot;AMENDMENT 1988 NO.24 ARTICLE 2&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"An amendment made in 1988 that affects the provisions related to employment agencies and their regulation."</data>
