  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"This is a condition under which an employee can receive disease津貼, indicating that they must have been employed continuously for at least one month before taking sick leave."</data>
  <data key="d2">chunk-e6ca8ea4c3347749e50a0bfdf049de28</data>
  <data key="d3">[{"level": 0, "cluster": 2}, {"level": 1, "cluster": 100}, {"level": 2, "cluster": 520}]</data>
