  <data key="d2">chunk-a953fb93e9985711bb86cdb5e869de50</data>
</node>
<node id="&quot;转制前部分&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"转制前部分指的是某指明僱員的遣散费或长期服务金中可归因于其转制前僱傭期的部分。"</data>
