  <data key="d2">chunk-80fae333d21f2886ed576bdc768e41f7</data>
  <data key="d3">[{"level": 0, "cluster": 16}, {"level": 1, "cluster": 224}, {"level": 2, "cluster": 804}, {"level": 3, "cluster": 1185}]</data>
</node>
<node id="&quot;CONSTRUCTION CONTRACT PARTIES&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Parties involved in construction contracts who have the right to submit payment disputes in court or other dispute resolution proceedings."</data>
  <data key="d2">chunk-80fae333d21f2886ed576bdc768e41f7</data>
