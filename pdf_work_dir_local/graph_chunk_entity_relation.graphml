  <data key="d2">chunk-5997efc3513d7a18a8e6ffade96f199b</data>
</node>
<node id="&quot;ANY PERSON WHO USES OR PROMOTES THE USE OF ANY PRESCRIBED PRODUCT&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"Any individual involved with using or promoting a specified product, subject to regulatory oversight and potential penalties."</data>
  <data key="d2">chunk-5997efc3513d7a18a8e6ffade96f199b</data>
</node>
<node id="&quot;WRITTEN DIRECTION GIVEN BY THE AUTHORITY&quot;">
