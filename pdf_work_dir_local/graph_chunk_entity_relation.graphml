<node id="&quot;137 OF 1997 S. 5&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"This is a reference to a specific amendment made in 1997, section 5, which may have modified the rules regarding rest days or holidays within an approved period of annual leave."</data>
  <data key="d2">chunk-e1ba134cba7bc0ad2b2ef34e757e78d3</data>
</node>
<node id="&quot;NO&quot;">
