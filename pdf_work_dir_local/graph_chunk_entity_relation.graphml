</node>
<node id="&quot;HOVERCRAFT&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"Hovercraft is a means of transportation mentioned in the text and applies to contracts where goods are carried by ship or hovercraft."</data>
  <data key="d2">chunk-a5ff7ccd88e0bf1fa24f736784b46e37</data>
  <data key="d3">[{"level": 0, "cluster": 48}, {"level": 1, "cluster": 400}, {"level": 2, "cluster": 1097}]</data>
</node>
