</node>
<node id="&quot;NOISE AT NIGHT OR ON A GENERAL HOLIDAY&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"This refers to the offense of making noise between 11 p.m. and 7 a.m., or during public holidays, in domestic premises or public places that is annoying to others."</data>
  <data key="d2">chunk-2d6887e7ca7e46f1099049e513eb84c4</data>
  <data key="d3">[{"level": 0, "cluster": 21}, {"level": 1, "cluster": 293}, {"level": 2, "cluster": 980}]</data>
</node>
