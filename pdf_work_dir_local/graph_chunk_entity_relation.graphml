  <data key="d0">"PERSON"</data>
  <data key="d1">"This refers to any individual committing a crime as defined in the legal context."</data>
  <data key="d2">chunk-ed8223cf90d5d4646feb10ec51169ca9</data>
  <data key="d3">[{"level": 0, "cluster": 48}, {"level": 1, "cluster": 401}]</data>
</node>
