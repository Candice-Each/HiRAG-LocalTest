  <data key="d7">1</data>
</edge>
<edge source="&quot;THIRD PARTY FUNDERS&quot;" target="&quot;FUNDED PARTIES&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Third party funders have obligations and procedures to follow in agreements with funded parties, including capital requirements, conflict of interest management, complaint handling, and annual reporting."</data>
  <data key="d6">chunk-24bcba17e89155ad11eeca80dd981ea9</data>
  <data key="d7">1</data>
</edge>
