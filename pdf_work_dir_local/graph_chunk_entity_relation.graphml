  <data key="d2">chunk-d02dce26d755dbc2a1f010f8cd0550db</data>
  <data key="d3">[{"level": 0, "cluster": 14}]</data>
</node>
<node id="&quot;WAR&quot;">
  <data key="d0">"LOCATION"</data>
  <data key="d1">"War is mentioned as a reason for contract frustration and settlement of disputes, indicating its significant impact on contractual obligations."</data>
  <data key="d2">chunk-5fa9c6366e076e445101d83858797035</data>
