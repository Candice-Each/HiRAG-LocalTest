  <data key="d6">chunk-adab7939e3cd66e530eb16d94f47de64</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;COMPENSATION EVALUATION CERTIFICATE FOR FATAL CASES&quot;" target="&quot;TEMPORARY PAYMENT CERTIFICATE&quot;">
  <data key="d4">8.0</data>
