  <data key="d4">7.0</data>
  <data key="d5">"An employee's wage is a factor in the calculation of their annual leave pay rate."</data>
  <data key="d6">chunk-5cf406b3b427b0e2efe01c3ec1bb9db4</data>
  <data key="d7">1</data>
</edge>
