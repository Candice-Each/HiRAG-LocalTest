  <data key="d2">chunk-e980522a1add368d13a641e842c93a83</data>
</node>
<node id="&quot;ANY PERSON WHO COMMITS AN OFFENCE UNDER SUBSECTION (1)&quot;">
  <data key="d0">"PERSON"</data>
