  <data key="d4">8.0</data>
  <data key="d5">"A daily fine of $200 is applicable for continuing offences against the provisions of this Ordinance and any related regulations."</data>
  <data key="d6">chunk-01f73d3a0eb5a63d428e456a11dad9c0</data>
  <data key="d7">1</data>
</edge>
