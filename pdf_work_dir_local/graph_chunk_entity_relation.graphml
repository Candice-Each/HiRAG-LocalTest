</node>
<node id="&quot;PUBLIC PLACES&quot;">
  <data key="d0">"LOCATION"</data>
  <data key="d1">"Public places include any area open to the general public and subject to noise control laws."&lt;SEP&gt;"This includes any area open to the general public and subject to noise regulation laws."</data>
  <data key="d2">chunk-ce50382ff024b176dc7ebf19fb5b68d4&lt;SEP&gt;chunk-2d6887e7ca7e46f1099049e513eb84c4</data>
