  <data key="d4">9.0</data>
  <data key="d5">"雇员的工作能力和其因损伤而受影响的程度相关联。"</data>
  <data key="d6">chunk-4e4b1d219d95c2446efb2aa90f70f687</data>
  <data key="d7">1</data>
</edge>
