  <data key="d4">6.0</data>
  <data key="d5">"The Ordinance provides guidelines for assessing loss of earning capacity. "</data>
  <data key="d6">chunk-cb828f2a7eae180f120101c1cd23e327</data>
  <data key="d7">1</data>
</edge>
