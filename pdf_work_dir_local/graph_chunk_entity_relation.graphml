<node id="&quot;POLICY NUMBER&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"Policy number identifies a unique document issued by an insurer, relevant in legal procedures concerning employer's responsibilities and insurance coverage."</data>
