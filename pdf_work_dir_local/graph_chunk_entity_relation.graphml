  <data key="d4">6.0</data>
  <data key="d5">"The employee's request for dividing annual leave can be granted under section 18(5)."</data>
  <data key="d6">chunk-e1ba134cba7bc0ad2b2ef34e757e78d3</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;137 OF 1997 S. 5&quot;" target="&quot;NO&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"No further amendments are made to sections related to annual leave according to this text."</data>
  <data key="d6">chunk-e1ba134cba7bc0ad2b2ef34e757e78d3</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;SECTION 41F&quot;" target="&quot;ANNUAL LEAVE&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"A business closure proposed to grant annual leave must comply with notice requirements under SECTION 41F, ensuring employees' rights are protected regarding consecutive days of leave."</data>
  <data key="d6">chunk-b63d3371d1b762c2013adc08da9c549f</data>
  <data key="d7">1</data>
</edge>
