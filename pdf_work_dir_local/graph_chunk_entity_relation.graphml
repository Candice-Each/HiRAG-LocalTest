  <data key="d2">chunk-d88cda6d2e850ba77bbd055819688849</data>
</node>
<node id="&quot;PAYMENT PERIOD END DATE&quot;">
  <data key="d0">"ATTRIBUTE"</data>
  <data key="d1">"The attribute of a specific date at the end of the payment period is used in determining when payments become due if not specified otherwise."</data>
  <data key="d2">chunk-d88cda6d2e850ba77bbd055819688849</data>
  <data key="d3">[{"level": 0, "cluster": 20}, {"level": 1, "cluster": 286}]</data>
</node>
<node id="&quot;7 DAYS PAYMENT DEADLINE&quot;">
