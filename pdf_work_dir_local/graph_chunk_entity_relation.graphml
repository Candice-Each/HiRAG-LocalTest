  <data key="d0">"PRODUCT"</data>
  <data key="d1">"An Occupation Permit or Temporary Occupation Permit issued under the Buildings Ordinance, certifying that a building constructed by or on behalf of Hong Kong Housing Authority is completed."</data>
  <data key="d2">chunk-1bf52072b8dd02eb0cf0d0e08e22d0cd</data>
  <data key="d3">[{"level": 0, "cluster": 0}, {"level": 1, "cluster": 56}, {"level": 2, "cluster": 435}]</data>
</node>
<node id="&quot;OWNER (擁有人)&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"A person who enters into a construction contract with another party for carrying out construction work or supplying related goods and services at a construction site."</data>
  <data key="d2">chunk-1bf52072b8dd02eb0cf0d0e08e22d0cd</data>
  <data key="d3">[{"level": 0, "cluster": 0}, {"level": 1, "cluster": 66}, {"level": 2, "cluster": 454}]</data>
