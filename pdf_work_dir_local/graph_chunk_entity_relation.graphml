<node id="&quot;LEVEL 5 FINE&quot;">
  <data key="d0">"MATHEMATICS"</data>
  <data key="d1">"A Level 5 fine refers to a specific monetary penalty as defined in the legal framework, applicable for non-compliance with notification requirements."&lt;SEP&gt;"A fine at level 5 refers to a specific penalty for providing false or misleading information as per the law."</data>
  <data key="d2">chunk-05288c51fb6c9855d3f031e51b7e2be3&lt;SEP&gt;chunk-ca6a3d09e67d65c6e2efdbaf610d6291</data>
