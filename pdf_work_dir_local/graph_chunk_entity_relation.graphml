  <data key="d4">8.0</data>
  <data key="d5">"A Medical Practitioner is part of an Ordinary Assessment Board that assesses loss of earning capacity. "</data>
  <data key="d6">chunk-cb828f2a7eae180f120101c1cd23e327</data>
  <data key="d7">1</data>
</edge>
