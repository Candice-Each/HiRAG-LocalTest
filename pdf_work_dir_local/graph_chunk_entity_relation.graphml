  <data key="d4">8.0</data>
  <data key="d5">"Health Officers are designated as Occupational Safety Officers under the Ordinance, indicating their role and authority in this context. "</data>
  <data key="d6">chunk-a3c3394a6b72977677a8a437b4151b9d</data>
  <data key="d7">1</data>
</edge>
