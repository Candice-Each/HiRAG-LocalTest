  <data key="d4">9.0</data>
  <data key="d5">"Research workers engaged in SARS research have close and frequent contacts with sources of SARS infection."</data>
  <data key="d6">chunk-f4b9235f66c4fbb5045cd3777eb4910c</data>
  <data key="d7">1</data>
</edge>
