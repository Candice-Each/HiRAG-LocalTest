  <data key="d4">7.0</data>
  <data key="d5">"Maternity leave is defined in Part III of the Maternity Leave provisions."</data>
  <data key="d6">chunk-765d51e319fa417bcf02401654532054</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;MINOR EMPLOYMENT CLAIMS ADJUDICATION BOARD ORDINANCE&quot;" target="&quot;FOURTH SCHEDULE (AMENDED BY 48 OF 1984 S.33)&quot;">
  <data key="d4">6.0</data>
