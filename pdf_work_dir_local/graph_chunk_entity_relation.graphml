  <data key="d3">[{"level": 0, "cluster": 1}, {"level": 1, "cluster": 82}]</data>
</node>
<node id="&quot;懷孕或分娩引致疾病或無工作能力的另一期間,以不超過4個星期為限。&quot;">
  <data key="d0">"MATHEMATICS"</data>
