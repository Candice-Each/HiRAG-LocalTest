  <data key="d7">1</data>
</edge>
<edge source="&quot;二硫化炭中毒&quot;" target="&quot;二硫化炭&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"二硫化炭是导致二硫化炭中毒的原因之一。"</data>
  <data key="d6">chunk-f0ecd9f44b5bcdd46ef57df26ba77a9f</data>
  <data key="d7">1</data>
</edge>
