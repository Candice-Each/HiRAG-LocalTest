  <data key="d2">chunk-59eee484f73e813248a005b2d6fef14a</data>
</node>
<node id="&quot;REQUIREMENTS RELATING TO NOISE EMISSION PRESCRIBED FOR THE PURPOSES OF THIS SUBSECTION&quot;">
  <data key="d0">"SOCIAL SCIENCES"</data>
