  <data key="d4">8.0</data>
  <data key="d5">"The Commissioner can assess compensation for loss of earning capacity as determined under specific sections."</data>
  <data key="d6">chunk-f1b7183db745ed54dff547be6105981a</data>
  <data key="d7">1</data>
</edge>
