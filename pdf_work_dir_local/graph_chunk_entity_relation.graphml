  <data key="d6">chunk-65ea11530f0e52e80a8fa97c146e6143</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;ARSENIC&quot;" target="&quot;SOOT&quot;">
  <data key="d4">5.0</data>
  <data key="d5">"Soot often contains arsenic, leading to similar health risks from exposure."</data>
  <data key="d6">chunk-65ea11530f0e52e80a8fa97c146e6143</data>
  <data key="d7">1</data>
</edge>
