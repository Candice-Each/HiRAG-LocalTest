  <data key="d2">chunk-ed8223cf90d5d4646feb10ec51169ca9</data>
  <data key="d3">[{"level": 0, "cluster": 48}, {"level": 1, "cluster": 401}]</data>
</node>
<node id="&quot;FINE OF $20,000 FOR EACH DAY DURING WHICH THE OFFENCE CONTINUES&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"A daily fine structure is outlined to penalize ongoing offenses."&lt;SEP&gt;"This outlines a daily fine structure to penalize ongoing violations related to product emissions and usage beyond initial conviction."</data>
