<node id="&quot;LONG-TERM SERVICE ALLOWANCE&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Long-term service allowance refers to a benefit provided by employers, which may need adjustments based on the calculation of average monthly wages over specified periods."</data>
  <data key="d2">chunk-4c5336f48f2648be18accb456b032c71</data>
  <data key="d3">[{"level": 0, "cluster": 9}, {"level": 1, "cluster": 169}, {"level": 2, "cluster": 698}]</data>
