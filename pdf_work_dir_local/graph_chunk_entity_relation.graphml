  <data key="d0">"PRODUCT"</data>
  <data key="d1">"This is the title of an ordinance section detailing the structure and function of ordinary assessment boards."</data>
  <data key="d2">chunk-cb828f2a7eae180f120101c1cd23e327</data>
  <data key="d3">[{"level": 0, "cluster": 5}, {"level": 1, "cluster": 140}, {"level": 2, "cluster": 620}]</data>
</node>
<node id="&quot;16E. 僱員補償(特別評估)委員會&quot;">
  <data key="d0">"EVENT"</data>
