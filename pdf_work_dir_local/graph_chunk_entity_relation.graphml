  <data key="d2">chunk-c56a21239b5d0bf5cb22840251170eef</data>
</node>
<node id="&quot;PROGRESS PAYMENT REASONS FOR RESPONDENT (答辯人)&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"The reasons given by a respondent regarding progress payments are considered in determining costs."</data>
  <data key="d2">chunk-c56a21239b5d0bf5cb22840251170eef</data>
</node>
<node id="&quot;CLAIMANT'S WITHDRAWAL OF PROCEEDINGS&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"A claimant withdrawing from proceedings can affect the determination of cost proportions, as indicated under section 40(1)."</data>
  <data key="d2">chunk-c56a21239b5d0bf5cb22840251170eef</data>
</node>
<node id="&quot;OTHER MATTERS CONSIDERED BY ADJUDICATOR&quot;">
