  <data key="d4">7.0</data>
  <data key="d5">"The general principles on which this law is based are considered in the interpretation of the law by the Commission."</data>
  <data key="d6">chunk-5a9efbbf91e4535558399760b519e3ef</data>
  <data key="d7">1</data>
</edge>
