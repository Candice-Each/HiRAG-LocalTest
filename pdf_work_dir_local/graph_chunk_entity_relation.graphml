  <data key="d4">7.0</data>
  <data key="d5">"The Chinese translation of SUBSECTION (2) is part of the legal framework that has been replaced by a specific section, indicating its historical context."</data>
  <data key="d6">chunk-cb527550097d8ae04c63a6dbcf448664</data>
  <data key="d7">1</data>
</edge>
