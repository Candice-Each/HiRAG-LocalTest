  <data key="d2">chunk-0c2575de447c966aae5e5a22feec1323</data>
  <data key="d3">[{"level": 0, "cluster": 16}]</data>
</node>
<node id="&quot;EMERGENCY STAFF&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Emergency staff refers to workmen and plant available for immediate use in case of emergencies related to the execution of works."&lt;SEP&gt;"Staff members designated to handle emergencies, mentioned in Clause 20 of the document."</data>
  <data key="d2">chunk-0c2575de447c966aae5e5a22feec1323&lt;SEP&gt;chunk-49aef112fabf90ecd0181146a7452f1a</data>
