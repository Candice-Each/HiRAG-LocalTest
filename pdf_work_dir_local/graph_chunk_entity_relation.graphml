  <data key="d4">7.0</data>
  <data key="d5">"The Special Condition of Tender requires a statement regarding convictions under this ordinance."</data>
  <data key="d6">chunk-b81accbb096ae8cbb3714136237139d7</data>
  <data key="d7">1</data>
</edge>
