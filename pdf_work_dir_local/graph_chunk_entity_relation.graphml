  <data key="d7">1</data>
</edge>
<edge source="&quot;處長&quot;" target="&quot;根據第(1)(A)款作出的裁定&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"處長可以主動審核由其他人提出的反對，以確保裁定正確無誤。"</data>
  <data key="d6">chunk-bb12a82fc5ab3ac5df679955dd98ef54</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;處長&quot;" target="&quot;反對書&quot;">
  <data key="d4">8.0</data>
