<node id="&quot;TENDER DOCUMENTS&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"The Tender Documents are official documents that contain items and figures which may require clarification from the Tenderer."&lt;SEP&gt;"These are official documents that contain items and figures which may require clarification from the Tenderer, relevant for Harbourfront Data Infrastructure Limited as it is involved in construction projects and tendering processes."</data>
  <data key="d2">&lt;SEP&gt;chunk-e6f1c507a5f83ea7cc30c5ceefa06210</data>
