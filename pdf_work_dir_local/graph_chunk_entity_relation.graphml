<node id="&quot;OBJECTOR&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"The objector refers to either an employer or an employee who raises objections, indicating a role in dispute resolution processes."</data>
  <data key="d2">chunk-0aa6a1ecbb96f241ec693e9b7796d393</data>
