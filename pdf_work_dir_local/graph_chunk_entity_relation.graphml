  <data key="d0">"CONCEPT"</data>
  <data key="d1">"The obligation for the design aspects of construction projects as per Clause 25 of the document."</data>
  <data key="d2">chunk-0c2575de447c966aae5e5a22feec1323</data>
</node>
<node id="&quot;INTERFERENCE WITH TRAFFIC AND ADJOINING PROPERTIES&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Issues that may arise due to disruptions in local traffic or adjacent property rights, detailed under Clause 26."</data>
  <data key="d2">chunk-0c2575de447c966aae5e5a22feec1323</data>
</node>
<node id="&quot;REMEDY ON FAILURE TO INSURE&quot;">
