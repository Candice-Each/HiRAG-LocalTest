  <data key="d4">9.0</data>
  <data key="d5">"The SPECIFIED DATE, derived from the Employment (Amendment) Ordinance 2022, is published in the GAZETTE."</data>
  <data key="d6">chunk-60efa76430de6c8c3995f39eeee4cc13</data>
  <data key="d7">1</data>
</edge>
