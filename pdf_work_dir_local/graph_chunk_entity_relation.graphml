  <data key="d4">8.0</data>
  <data key="d5">"Poultry handling is directly involved with the occupational contact with birds infected by avian influenza A."</data>
  <data key="d6">chunk-f4b9235f66c4fbb5045cd3777eb4910c</data>
  <data key="d7">1</data>
</edge>
