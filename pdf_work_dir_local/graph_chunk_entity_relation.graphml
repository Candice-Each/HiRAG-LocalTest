<node id="&quot;CONTRACT OF SERVICE OR APPRENTICESHIP&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"This term describes the employment contract under which an employee was working at the time of injury, indicating a formal agreement between employer and employee that outlines terms of work and responsibilities."</data>
  <data key="d2">chunk-0d861619a56054d36c585396a6494755</data>
