  <data key="d6">chunk-2d685de840aec3e84c6ab3d5c85a2c77</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;《領養條例》(第290章)&quot;" target="&quot;由2004年第28號第35條修訂&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"领养条例条款被其他条款修订，两者之间有直接联系。"</data>
  <data key="d6">chunk-2d685de840aec3e84c6ab3d5c85a2c77</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;《領養條例》(第290章)&quot;" target="&quot;由2000年第52號第3條修訂&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"领养条例条款被其他条款修订，两者之间有直接联系。"</data>
  <data key="d6">chunk-2d685de840aec3e84c6ab3d5c85a2c77</data>
