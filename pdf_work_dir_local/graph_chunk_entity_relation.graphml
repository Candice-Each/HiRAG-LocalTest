  <data key="d4">8.0</data>
  <data key="d5">"This section covers the determination of compensation in cases involving loss of earning capacity from injuries."</data>
  <data key="d6">chunk-f1b7183db745ed54dff547be6105981a</data>
  <data key="d7">1</data>
</edge>
