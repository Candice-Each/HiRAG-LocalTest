  <data key="d6">chunk-b94648c694477d4222a0ec6ba5f496e8</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;僱主、任何已根據該款提出申請的人或管理局&quot;" target="&quot;有權獲去世僱員的殯殮費或醫護費的付還的人&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"這些主体可以在不同情況下對裁定提出反對，具體時間限制相同。"</data>
  <data key="d6">chunk-bb12a82fc5ab3ac5df679955dd98ef54</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;有權獲去世僱員的殯殮費或醫護費的付還的人根據《僱員補償援助條例》(第365章)第16條提出申請的日期後30天&quot;" target="&quot;有關殯殮費和醫護費證明書的發出日期後30天&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"兩者都是反對書提交期限的一部分，但適用於不同的情況。"</data>
  <data key="d6">chunk-bb12a82fc5ab3ac5df679955dd98ef54</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;接獲反對書的情況&quot;" target="&quot;處長須接納或拒絕反對書&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"根據第(12)(a)款，處長需要處理收到的反對書，決定是否接受。"</data>
  <data key="d6">chunk-bb12a82fc5ab3ac5df679955dd98ef54</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;他認為該項裁定是在對作出申索的情況不知情或錯誤理解之下作出的&quot;" target="&quot;處長可以主動審核上述裁定&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"根據第(11)(a)款，處長可以在特定情況下主動進行審核。"</data>
  <data key="d6">chunk-bb12a82fc5ab3ac5df679955dd98ef54</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;處長可以主動審核上述裁定&quot;" target="&quot;他認為該項裁定是以向他提供或作出的虛假或具誤導性的資料或陳述為依據的&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"根據第(11)(b)款，處長可以在特定情況下主動進行審核。"</data>
  <data key="d6">chunk-bb12a82fc5ab3ac5df679955dd98ef54</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;任何人&quot;" target="&quot;無合理辯解而沒有提供或拒绝提供任何根据本条规定的须提供的详情&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"无合理理由不提供或拒绝提供所需信息被视为犯罪行为。"</data>
  <data key="d6">chunk-272edd512c0a77f2dcb99ca42f01d356</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;1995年第4條&quot;" target="&quot;僱主與受傷僱員訂立並獲&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"1995年第4條增補了关于僱主和受傷僱員之间的协议，说明两者之间有关系。"</data>
  <data key="d6">chunk-430e5976cb2d37cf2cc19b50c8f851c3</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;僱主與受傷僱員訂立並獲&quot;" target="&quot;第8(1)(A)條&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"第8(1)(A)條可能与僱主和受伤员工之间的协议有关，但具体关系需进一步明确以确定其确切性质和强度。"</data>
  <data key="d6">chunk-430e5976cb2d37cf2cc19b50c8f851c3</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;ACTUAL EARNINGS OF EMPLOYEE AFTER ACCIDENT CAUSING INJURY&quot;" target="&quot;EMPLOYEE EARNINGS AFTER ACCIDENT CAUSING INJURY&quot;">
  <data key="d4">7.0</data>
