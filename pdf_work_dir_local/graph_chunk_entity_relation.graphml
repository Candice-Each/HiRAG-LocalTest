  <data key="d4">6.0</data>
  <data key="d5">"Exposure to any other sensitising agent inhaled at work may contribute to the development of carpal tunnel syndrome, though not directly listed as a cause."</data>
  <data key="d6">chunk-7306865e35ebfb2e70b787c62738f5ca</data>
  <data key="d7">1</data>
</edge>
