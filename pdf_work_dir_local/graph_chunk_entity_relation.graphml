<node id="&quot;MAINTENANCE SURVEYOR'S REPRESENTATIVE'S CHECK FACILITY&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"This refers to the ability of the Maintenance Surveyor's representative to verify the accuracy of submitted documents by checking time and materials."</data>
  <data key="d2">chunk-c0c5e3d59d6713fc43836ebeb09b59a0</data>
</node>
<node id="&quot;DRAWINGS, SPECIFICATION, DETAILS OR LEVELS FROM THE MAINTENANCE SURVEYOR&quot;">
